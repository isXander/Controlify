        "none_of": ["controlify:is_toggle_sneak", "controlify:sneaking"]
      },
      "then": { "translate": "controlify.guide.ingame.sneak" }
    },
    {
      "for": "controlify:sprint",
      "where": "left",
      "if": {
        "all_of": ["controlify:verbosity_reduced", "controlify:input_moving", "controlify:under_water"],
        "none_of": ["controlify:sprinting", "controlify:in_vehicle", "controlify:flying"]
      },
      "then": { "translate": "controlify.guide.ingame.start_swimming" }
    },
    {
      "for": "controlify:sprint",
      "where": "left",
