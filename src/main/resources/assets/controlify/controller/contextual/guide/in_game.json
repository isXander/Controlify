{
  "rules": [
    {
      "for": "controlify:jump",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:riding_happy_ghast"] },
      "then": { "translate": "controlify.guide.ingame.fly_up" }
    },
    {
      "for": "controlify:jump",
      "where": "left",
      "if": {
        "all_of": [
          "controlify:verbosity_minimal",
          { "any_of": ["controlify:riding_saddled_camel", "controlify:riding_saddled_nautilus"] }
        ]
      },
      "then": { "translate": "controlify.guide.ingame.dash" }
    },
    {
      "for": "controlify:jump",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:riding_saddled_equine"] },
      "then": { "translate": "key.jump" }
    },
    {
      "for": "controlify:jump",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:creative_flying"] },
      "then": { "translate": "controlify.guide.ingame.fly_up" }
    },
    {
      "for": "controlify:jump",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:in_water"] },
      "then": { "translate": "controlify.guide.ingame.swim_up" }
    },
    {
      "for": "controlify:jump",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:on_climbable"] },
      "then": { "translate": "controlify.guide.ingame.climb_up" }
    },
    {
      "for": "controlify:jump",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:on_ground"] },
      "then": { "translate": "key.jump" }
    },
    {
      "for": "controlify:jump",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:can_elytra_fly"] },
      "then": { "translate": "controlify.guide.ingame.start_elytra" }
    },
    {
      "for": "controlify:sneak",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:in_vehicle"] },
      "then": { "translate": "controlify.guide.ingame.dismount" }
    },
    {
      "for": "controlify:sneak",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:creative_flying"] },
      "then": { "translate": "controlify.guide.ingame.fly_down" }
    },
    {
      "for": "controlify:sneak",
      "where": "left",
      "if": {
        "all_of": ["controlify:verbosity_minimal", "controlify:in_water"],
        "none_of": ["controlify:on_ground"]
      },
      "then": { "translate": "controlify.guide.ingame.swim_down" }
    },
    {
      "for": "controlify:sneak",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:on_climbable"] },
      "then": { "translate": "controlify.guide.ingame.climb_down" }
    },
    {
      "for": "controlify:sneak",
      "where": "left",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:is_toggle_sneak", "controlify:sneaking"] },
      "then": { "translate": "controlify.guide.ingame.stop_sneaking" }
    },
    {
      "for": "controlify:sneak",
      "where": "left",
      "if": {
        "all_of": ["controlify:verbosity_minimal", "controlify:is_toggle_sneak"],
        "none_of": ["controlify:sneaking"]
      },
      "then": { "translate": "controlify.guide.ingame.start_sneaking" }
