        "all_of": ["controlify:verbosity_reduced", "controlify:sprinting", "controlify:is_toggle_sprint", "controlify:under_water"],
        "none_of": ["controlify:in_vehicle", "controlify:flying"]
      },
      "then": { "translate": "controlify.guide.ingame.stop_swimming" }
    },
    {
