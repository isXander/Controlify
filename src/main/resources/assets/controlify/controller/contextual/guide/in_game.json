      "if": {
        "all_of": ["controlify:verbosity_minimal", "controlify:looking_at_entity"],
        "none_of": ["controlify:is_spectator"]
      },
      "then": { "translate": "controlify.guide.ingame.interact" }
    },
    {
      "for": "controlify:use",
      "where": "right",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:looking_at_block"] },
      "then": { "translate": "controlify.guide.ingame.use" }
    },
    {
      "for": "controlify:use",
      "where": "right",
      "if": { "all_of": ["controlify:verbosity_minimal", "controlify:has_item_in_either_hand"] },
      "then": { "translate": "controlify.guide.ingame.use" }
    },
    {
      "for": "controlify:drop",
      "where": "right",
      "if": { "all_of": ["controlify:verbosity_reduced", "controlify:has_item_in_main_hand"] },
      "then": { "translate": "controlify.guide.ingame.drop" }
    },
    {
      "for": "controlify:drop_stack",
      "where": "right",
      "if": { "all_of": ["controlify:verbosity_full", "controlify:has_multiple_items_in_main_hand"] },
      "then": { "translate": "controlify.binding.controlify.drop_stack" }
    },
    {
      "for": "controlify:swap_hands",
      "where": "right",
      "if": { "all_of": ["controlify:verbosity_reduced", "controlify:has_item_in_either_hand"] },
      "then": { "translate": "controlify.guide.ingame.swap_hands" }
    },
    {
      "for": "controlify:pick_block",
      "where": "right",
      "if": { "all_of": ["controlify:verbosity_full", "controlify:looking_at_block", "controlify:is_creative"] },
      "then": { "translate": "controlify.guide.ingame.pick_block" }
    },
    {
      "for": "controlify:pick_block_nbt",
      "where": "right",
      "if": { "all_of": ["controlify:verbosity_full", "controlify:looking_at_block", "controlify:is_creative"] },
      "then": { "translate": "controlify.binding.controlify.pick_block_nbt" }
    }
  ]
}
