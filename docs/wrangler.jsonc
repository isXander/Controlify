/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "controlify",
  "compatibility_date": "2026-08-11",

  "build": {
    "command": "bun run build"
  },
  "assets": {
    "directory": "./.vitepress/dist"
  },

  // CDN Cache for Workers!
  "cache": {
    "enabled": true
  },

  // Do not publish site to *.workers.dev
  "workers_dev": false,
  // ...except for preview deployments
  "preview_urls": true,

  "routes": [
    {
      "pattern": "controlify.isxander.dev",
      "zone_name": "isxander.dev",
      "custom_domain": true
    }
  ]
}
